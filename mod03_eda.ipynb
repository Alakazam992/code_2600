  {
   "cell_type": "markdown",
   "id": "2499b3be",
   "metadata": {},
   "source": [
    "### Before doing any other analyses, let's create training and test sets."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "4a826ee5",
   "metadata": {},
   "outputs": [],
   "source": [
    "Train, Test = train_test_split(Hitters, \n",
    "                               random_state=seed, \n",
    "                               test_size=0.40, \n",
    "                               shuffle=True) "
   ]
